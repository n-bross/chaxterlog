# Next.js (.env.local); npx convex dev writes deployment and URL.
CONVEX_DEPLOYMENT=dev:YOUR_DEPLOYMENT
NEXT_PUBLIC_CONVEX_URL=https://YOUR_DEPLOYMENT.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://YOUR_DEPLOYMENT.convex.site
NEXT_PUBLIC_SITE_URL=http://localhost:3002
# Used only by scripts/setup-admin.mjs; must match the intended website.
SITE_URL=http://localhost:3002

# Set on the Convex deployment, not in the browser or NEXT_PUBLIC_*:
# npx convex env set BETTER_AUTH_SECRET "<at least 32 random characters>"
# npx convex env set SITE_URL http://localhost:3002
# Production: repeat with --prod and the production HTTPS origin.
# Vercel only: CONVEX_DEPLOY_KEY (production deploy key; private).
